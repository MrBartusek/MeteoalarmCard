{
    "name": "meteoalarm-card",
    "version": "2.8.0",
    "description": "Meteoalarm card for Home Assistant Lovelace UI",
    "main": "dist/meteoalarm-card.js",
    "keywords": [
        "home-assistant",
        "homeassistant",
        "lovelace",
        "custom-cards",
        "meteoalarm",
        "lovelace-card",
        "meteoalarmeu"
    ],
    "author": "MrBartusek",
    "type": "module",
    "license": "MIT",
    "homepage": "https://github.com/MrBartusek/MeteoalarmCard",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MrBartusek/MeteoalarmCard.git"
    },
    "bugs": {
        "url": "https://github.com/MrBartusek/MeteoalarmCard/issues"
    },
    "module": "meteoalarm-card.js",
    "packageManager": "pnpm@11.9.0",
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "start": "vite build && concurrently --kill-others --names build,serve \"vite build --watch --emptyOutDir false\" \"vite preview\"",
        "dev": "pnpm run dev:clean && pnpm run env:seed && pnpm run env:up",
        "dev:down": "docker compose -f hass-dev/docker-compose.yml down",
        "dev:clean": "pnpm run dev:down && docker compose -f hass-dev/docker-compose.yml run --rm clean",
        "env:seed": "node hass-dev/seed.ts",
        "env:up": "docker compose -f hass-dev/docker-compose.yml up -d",
        "build": "pnpm run typecheck && vite build",
        "typecheck": "tsc --noEmit && tsc -p hass-dev",
        "build-tools": "tsc -p tools",
        "fix-translations": "node tools/dist/fix-translations.js",
        "translations-summary": "node tools/dist/translations-summary",
        "lint": "eslint . --ext .ts,.cjs"
    },
    "dependencies": {
        "custom-card-helpers": "^2.0.0",
        "lit": "^3.3.0",
        "swiper": "^8.2.2"
    },
    "devDependencies": {
        "@types/node": "^22.20.0",
        "@typescript-eslint/eslint-plugin": "^6.7.5",
        "@typescript-eslint/parser": "^6.7.5",
        "concurrently": "^9.2.1",
        "eslint": "^8.51.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.1",
        "home-assistant-js-websocket": "^9.6.0",
        "prettier": "^3.0.3",
        "terser": "^5.50.0",
        "typescript": "^5.9.3",
        "vite": "^8.2.1"
    }
}
